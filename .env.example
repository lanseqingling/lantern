APP_ENV=local
WEB_ORIGIN=http://localhost:3000
API_PORT=18787
LANTERN_API_INTERNAL_URL=http://127.0.0.1:18787
NEXT_PUBLIC_LANTERN_RUNTIME_ADAPTER=server
# Optional: direct browser API origin. Leave empty to use the same-origin /api/backend proxy.
NEXT_PUBLIC_LANTERN_API_URL=

DATABASE_URL=postgresql://lantern:lantern@localhost:54329/lantern?schema=public
REDIS_URL=redis://localhost:56379
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_LOCAL_DIR=.lantern-runtime/objects
SESSION_SECRET=replace-this-outside-local-development

# Keep the legacy Agent conversation entry frozen until the controlled toolchain is ready.
AGENT_EXECUTION_MODE=disabled

TEXT_MODEL_PROVIDER=deepseek
TEXT_MODEL_BASE_URL=https://api.deepseek.com
TEXT_MODEL_NAME=deepseek-v4-flash
TEXT_MODEL_API_KEY=

IMAGE_MODEL_PROVIDER=qwen
IMAGE_MODEL_BASE_URL=https://dashscope.aliyuncs.com/api/v1
IMAGE_MODEL_NAME=qwen-image-2.0
IMAGE_MODEL_API_KEY=

# Local-only controlled identity. Production must use trusted auth headers/session.
LANTERN_DEV_USER_EMAIL=creator@lantern.local
