# Contributor-only process overrides. User configuration is created under
# the Lantern data directory by `npm start`.
APP_ENV=local

# Optional isolated development data directory. Leave empty to use the
# platform-standard Lantern user data directory.
LANTERN_DATA_DIR=

# Optional development port overrides. User installations should edit
# <Lantern data directory>/config/runtime.json instead.
WEB_PORT=18788
API_PORT=18787
LANTERN_API_INTERNAL_URL=http://127.0.0.1:18787

NEXT_PUBLIC_LANTERN_RUNTIME_ADAPTER=server

# Tests and local model-adapter probes may override provider settings in the
# process environment. Normal user keys belong in config/providers.env.
